# ---------------------------------------------------------------------
# Copiar a `.env` y completar. NUNCA commitear el `.env` real.
# ---------------------------------------------------------------------

# Neon (PostgreSQL serverless). En el dashboard de Neon, usar la cadena
# "Pooled connection" (incluye -pooler) para runtime, con sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/battlequiz?sslmode=require"

# Neon expone también una conexión DIRECTA (sin -pooler). Prisma la usa
# solo para migraciones (migrate deploy). Si no la separas, Prisma puede
# fallar migraciones a través del pooler.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/battlequiz?sslmode=require"

# JWT
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio-min-32-chars"
JWT_EXPIRES_IN="60m"

# App
PORT=3000
NODE_ENV=development
