<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Estilos base de BattleQuiz. Definen la apariencia por defecto de los
    controles y estilos con clave reutilizables (tarjetas, botones, títulos).
    Las vistas aplican estos estilos en vez de repetir propiedades.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ===================== Página ===================== -->
    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource BgBase}" />
        <Setter Property="Shell.NavBarIsVisible" Value="False" />
    </Style>

    <!-- ===================== Tipografía ===================== -->
    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style x:Key="Display" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="26" />
    </Style>

    <Style x:Key="H1" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="20" />
    </Style>

    <Style x:Key="H2" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style x:Key="Caption" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="Muted" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- ===================== Tarjetas ===================== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
        <Setter Property="Stroke" Value="{StaticResource Border}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="18" />
        </Setter>
    </Style>

    <Style x:Key="CardAlt" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceAlt}" />
    </Style>

    <!-- ===================== Botones ===================== -->
    <!-- Acción principal (naranja) -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
        <Setter Property="TextColor" Value="{StaticResource AccentDark}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HeightRequest" Value="54" />
        <Setter Property="CornerRadius" Value="16" />
    </Style>

    <!-- Acción secundaria (violeta) -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
        <Setter Property="TextColor" Value="{StaticResource BgBase}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HeightRequest" Value="54" />
        <Setter Property="CornerRadius" Value="16" />
    </Style>

    <!-- Botón fantasma (texto) -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="HeightRequest" Value="48" />
    </Style>

    <!-- ===================== Entradas ===================== -->
    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TextMuted}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <!-- Campo de formulario (Border envolviendo un Entry) -->
    <Style x:Key="Field" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource OptionBg}" />
        <Setter Property="Stroke" Value="{StaticResource Border}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="14,4" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="14" />
        </Setter>
    </Style>

    <!-- ===================== Pills / chips ===================== -->
    <Style x:Key="ChipBorder" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceElevated}" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="20" />
        </Setter>
    </Style>

</ResourceDictionary>
