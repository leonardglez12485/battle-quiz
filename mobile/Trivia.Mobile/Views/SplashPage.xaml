<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Trivia.Mobile.Views.SplashPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <Grid Background="{StaticResource PageGradient}">
        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="20">
            <Image Source="logo.png" WidthRequest="112" HeightRequest="112" HorizontalOptions="Center" />
            <Label Text="BattleQuiz" Style="{StaticResource Display}" HorizontalOptions="Center" />
            <Label Text="Poné a prueba tu conocimiento"
                   Style="{StaticResource Caption}"
                   HorizontalOptions="Center" />
            <ActivityIndicator IsRunning="True" Color="{StaticResource Accent}" Margin="0,16,0,0" />
        </VerticalStackLayout>
    </Grid>

</ContentPage>
